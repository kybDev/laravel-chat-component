{
    "name": "kybdev/laravel-chat-component",
    "version": "0.3.0",
    "description": "Reusable Laravel chat package designed for multi-application integration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\LaravelChat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\LaravelChat\\LaravelChatServiceProvider"
            ]
        }
    }
}
